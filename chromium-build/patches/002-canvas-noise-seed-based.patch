 namespace blink {

+// ─────────────────────────────────────────────────────────────────────────────
+// [GEEKEZ PATCH 002] Canvas Noise Implementation
+// ─────────────────────────────────────────────────────────────────────────────
+
+// static
+uint32_t CanvasRenderingContext2D::GetCanvasNoiseSeed() {
+  static uint32_t cached_seed = 0;
+  static bool initialized = false;
+
+  if (!initialized) {
+    initialized = true;
+    const base::CommandLine* cmd = base::CommandLine::ForCurrentProcess();
+    if (cmd && cmd->HasSwitch("canvas-noise-seed")) {
+      std::string seed_str = cmd->GetSwitchValueASCII("canvas-noise-seed");
+      uint32_t parsed_seed = 0;
+      if (base::StringToUint(seed_str, &parsed_seed)) {
+        cached_seed = parsed_seed;
+      }
+    }
+  }
+  return cached_seed;
+}
+
+// static - Linear Congruential Generator (deterministic, fast)
+uint32_t CanvasRenderingContext2D::LcgNext(uint32_t& state) {
+  // Parameters from Numerical Recipes (high quality LCG)
+  state = state * 1664525u + 1013904223u;
+  return state;
+}
+
+// static
+void CanvasRenderingContext2D::ApplyCanvasNoise(
+    uint8_t* pixels, size_t length, uint32_t seed) {
+  if (!pixels || length == 0 || seed == 0) return;
+
+  uint32_t state = seed;
+
+  // Modify every 53rd pixel alpha channel (imperceptible, consistent with
+  // existing fingerprint-chromium approach)
+  for (size_t i = 0; i < length; i += 4) {
+    // Use position + seed to determine if this pixel gets noise
+    if ((i / 4 + seed) % 53 == 0) {
+      // Generate noise: range [-1, +1] in alpha channel
+      uint32_t rnd = LcgNext(state);
+      float noise = (static_cast<float>(rnd & 0xFF) / 255.0f - 0.5f) * 2.0f;
+
+      // Apply to alpha channel (index i+3)
+      float original = static_cast<float>(pixels[i + 3]);
+      float modified = std::max(0.0f, std::min(255.0f, original + noise));
+      pixels[i + 3] = static_cast<uint8_t>(modified);
+    }
+  }
+}
+
 ImageData* CanvasRenderingContext2D::getImageData(
     int sx, int sy, int sw, int sh,
     ExceptionState& exception_state) const {
-  // ... existing implementation ...
-  return result;
+  // Get original image data
+  ImageData* result = GetImageDataOriginal(sx, sy, sw, sh, exception_state);
+  if (!result || exception_state.HadException()) return result;
+
+  // [GEEKEZ PATCH 002] Apply canvas noise if seed is set
+  uint32_t seed = GetCanvasNoiseSeed();
+  if (seed != 0) {
+    DOMUint8ClampedArray* data = result->data();
+    if (data && data->Data()) {
+      ApplyCanvasNoise(data->Data(), data->length(), seed);
+    }
+  }
+
+  return result;
